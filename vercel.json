{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/de/partners",
      "destination": "/de/partner",
      "permanent": true
    },
    {
      "source": "/de/partners/:slug",
      "destination": "/de/partner/:slug",
      "permanent": true
    }
  ]
}
